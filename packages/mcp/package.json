{
  "name": "@stave/mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets Claude Code read and change the songs and visuals in a paired Stave tab",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "bin": {
    "stave-mcp": "./dist/cli.js"
  },
  "exports": {
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/ws": "^8.5.12",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
